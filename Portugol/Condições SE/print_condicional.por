programa
{
	
	funcao inicio()
	{
		real n
		escreva("escreva seu número: ")
		leia(n)
		se(n <= 10){
			escreva("F1")
			
		}
		senao{
		   se(n > 10 e n <= 100){
		     escreva("F2")
		   }
		   senao{
		   	escreva("F3")
		   }
		}
	}
}
