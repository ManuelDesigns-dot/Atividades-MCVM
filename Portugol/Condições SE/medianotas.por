programa
{
	
	funcao inicio()
	{
	     cadeia nome
	     real n1,n2,n3,media
		escreva("Forneça o nome do aluno: ")
		leia(nome)
		escreva("Forneça a primeira nota do aluno: ")
		leia(n1)
		escreva("Forneça a segunda nota do aluno: ")
		leia(n2)
		escreva("Forneça a terceira nota do aluno: ")
		leia(n3)
		media = (n1+n2+n3)/3
		escreva("[========]\n")
		escreva("- Aluno: ", nome, "\n A média das notas desse aluno são: ", n1, " + ", n2, " + ", n3, "/", "3", " igualando á ", media)
	}
}
