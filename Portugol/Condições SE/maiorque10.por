programa
{
	
	funcao inicio() {
	inteiro a
		escreva("Insira um valor de sua escolha: ")
		leia(a)
	     se (a > 10) {
	 	 escreva("\n", a," É maior que 10.")
	     }
	     senao {
	      escreva("\n", a," É menor que 10.")
	     }	
	} 	
}
