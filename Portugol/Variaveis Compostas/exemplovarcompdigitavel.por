programa
{
	
	funcao inicio() // Exemplo de varíavel composta de dois pares que aceita que o úsuario insira as informações
	{
		cadeia nome[5] 
		para(inteiro i=0;i<=4;i++){
			escreva("Insira o ",i,"° vetor: ")
			leia(nome[i])
		}
		para(inteiro i=0;i<=4;i++){
			escreva("\n",nome[i])
		}
	}
}
