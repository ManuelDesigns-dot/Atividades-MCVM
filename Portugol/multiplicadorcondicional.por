programa
{
	
	funcao inicio()
	{
	real a,mult
		escreva("Digite seu valor: ")
		leia(a)
		se(a >=0) {
	      mult=a*2
		 escreva(a, " é positivo e sua multiplicação por 2x é: ",mult)
		 }
		senao {
		 mult=a*3
		 escreva(a, " é negativo e sua multiplicação por 3x é: ",mult)
		}
	}
}
