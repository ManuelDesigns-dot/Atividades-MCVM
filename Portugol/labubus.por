programa
{
	
	funcao inicio()
	{
		inteiro labubus
		escreva("Quantos labubus quer? 3 ou mais: ")
		leia(labubus)
		escolha(labubus){
			caso 1: escreva("Não pode.")
			pare
			caso 2: escreva("Ainda não pode.")
			pare
			caso 3: escreva("Okay, agora temos sua informação e não vamos mandar os laybubus")
			pare
			caso contrario: escreva("Não temos")
			pare
		}
	}
}
