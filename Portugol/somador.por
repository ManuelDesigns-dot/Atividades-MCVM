programa
{
	
	funcao inicio()
	{
		inteiro a,b,soma
		escreva("Bem vindo ao SomaOS! Por favor inicie sua soma colocando o primeiro valor da soma: ")
		leia(a)
		escreva("Digite o segundo valor! : ")
		leia(b)
		soma = a+b
		escreva("Calculando valor . . . \n")
		escreva(" O valor de sua soma ",a," + ",b,", é igual á " ,soma, ". \n")
	}
}
