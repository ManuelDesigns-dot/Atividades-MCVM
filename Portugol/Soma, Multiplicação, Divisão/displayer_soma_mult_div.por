programa
{
	
	funcao inicio()
	{
	     escreva(" ██████╗ █████╗ ██╗      ██████╗ ██╗   ██╗██╗      ██████╗ \n██╔════╝██╔══██╗██║     ██╔════╝ ██║   ██║██║     ██╔═══██╗\n██║     ███████║██║     ██║      ██║   ██║██║     ██║   ██║\n██║     ██╔══██║██║     ██║      ██║   ██║██║     ██║   ██║\n╚██████╗██║  ██║███████╗╚██████╗ ╚██████╔╝███████╗╚██████╔╝\n ╚═════╝╚═╝  ╚═╝╚══════╝ ╚═════╝  ╚═════╝ ╚══════╝╚══════╝\n")
		real a,b,soma,mult,div
		escreva("Digite o primeiro valor: ")
		leia(a)
		escreva("Digite o segundo valor: ")
		leia(b)
		soma = a+b
		mult = a*b
		div = a/b
		escreva("Os seus valores são os seguintes: \n", "| - Soma: " ,a, " + " ,b, " é igual a: " ,soma, "\n [====]", "\n| - Multiplicação: " ,a, " * " ,b, " é igual a: " ,mult,"\n [====]", "\n| - Divisão: " ,a, " / " ,b, " é igual a: " ,div)
		escreva("\n[ END ]")
	}
}
