programa
{
	
	funcao inicio()
	{
		real base,altura,area
		escreva("Digite a Base: ")
		leia(base)
		escreva("Digite a Altura: ")
		leia(altura)
		area = (base*altura)/2
		escreva("Sua área é: ",area)
	}
}
