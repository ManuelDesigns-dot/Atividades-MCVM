programa
{
	
	funcao inicio()
	{
	cadeia nome
	nome = "Mikhaelly "
	real n1, n2, n3
	n1 = 9.4
	n2 = 10.0
	n3 = 1.0
	escreva("Nome Do Aluno: ", nome, "\n")
	escreva("Nota 1: ", n1, "\nNota 2: ", n2 , "\nNota 3: ", n3)
	}
}
