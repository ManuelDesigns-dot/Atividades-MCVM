programa
{
	
	funcao inicio()
	{
		real raio,PI,area
		escreva("Insira o raio de sua circunferência: ")
		leia(raio)
		PI = 3.14
		area = PI*(raio*raio)
		escreva("Sua área é: ",area)
		
	}
}
