programa
{
	
	funcao inicio()
	{
	     inteiro anoatual,nascimento,idade
		escreva("Digite o ano atual: ")
		leia(anoatual)
		escreva("Digite o ano de nascimento: ")
		leia(nascimento)
			idade = anoatual-nascimento
		escreva("A sua idade, com as seguintes datas ", nascimento,"-",anoatual," é igual a: ", idade)
		
	}
}
